# Streamlit Cloud: 앱 설정 → Secrets 에 아래 내용을 붙여넣기 (로컬은 .streamlit/secrets.toml 로 저장)
HOSTING = "github"            # github | s3 | url
IG_USER_ID = "1784..."        # 인스타 비즈니스 계정 ID (팔로워 자동화 스크립트와 동일)
IG_ACCESS_TOKEN = "EAAB..."   # instagram_content_publish 권한 포함 장기 토큰
GITHUB_TOKEN = "github_pat_..." # Fine-grained PAT: 호스팅 저장소 Contents(write) + Pages(write) + Administration(write, 저장소 자동생성용)
MEDIA_REPO = "loveet3-hue/ogq-reels-media"

# S3/R2 사용 시
# S3_BUCKET = ""
# S3_ACCESS_KEY = ""
# S3_SECRET_KEY = ""
# S3_ENDPOINT = ""       # Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# S3_REGION = "auto"
# S3_PUBLIC_BASE = ""    # R2 공개 도메인 (https://pub-xxxx.r2.dev)
